# Database Configuration
MONGODB_URI=mongodb://localhost:27017/earthquake-db

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
REDIS_HOST=localhost
REDIS_PORT=6379

# Dragonfly Configuration (Redis-compatible drop-in replacement)
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6379
# App-data client: bounded retries + short commandTimeout so a Dragonfly
# outage never makes a single HTTP request hang for more than ~1s.
# The BullMQ side still uses maxRetriesPerRequest=null internally.
DRAGONFLY_COMMAND_TIMEOUT_MS=500
DRAGONFLY_CONNECT_TIMEOUT_MS=1000
DRAGONFLY_MAX_RETRIES=2

# Data Retention (RAM cleanup)
MAX_RECORDS_IN_MEMORY=5000
EARTHQUAKE_DATA_TTL=86400
SEARCH_CACHE_TTL=300
CLEANUP_INTERVAL_MS=600000
# Warmer: how far back to pull from MongoDB to seed/repair the cache.
WARMER_LOOKBACK_MS=86400
# Warmer cron interval (ms). The startup warmer also runs once on boot.
WARMER_INTERVAL_MS=300000

RABBITMQ_EXCHANGE=earthquake_exchange
RABBITMQ_QUEUE=earthquake_queue

# MQTT Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC=earthquakes/alerts

# API Configuration
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
API_RATE_LIMIT_MS=30000

# Server Configuration
PORT=6000
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs

# Application Settings
EARTHQUAKE_FETCH_INTERVAL=30000
MIN_MAGNITUDE_ALERT=4.0
MAX_EARTHQUAKES_PER_FETCH=10
