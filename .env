# Database Configuration
MONGODB_URI=mongodb://root:root@localhost:43982/earthquake-db?authSource=admin

# Redis / Dragonfly Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6379
DRAGONFLY_COMMAND_TIMEOUT_MS=500
DRAGONFLY_CONNECT_TIMEOUT_MS=1000
DRAGONFLY_MAX_RETRIES=2

# Data Retention (RAM cleanup)
MAX_RECORDS_IN_MEMORY=5000
EARTHQUAKE_DATA_TTL=86400
SEARCH_CACHE_TTL=300
CLEANUP_INTERVAL_MS=600000
WARMER_LOOKBACK_MS=86400000
WARMER_INTERVAL_MS=300000

# RabbitMQ Configuration
RABBITMQ_URL=amqp://rabbit:rabbit@localhost:42107

# MQTT Configuration
MQTT_BROKER_URL=mqtt://localhost:45329
MQTT_TOPIC=earthquakes/alerts

# API Configuration
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
API_RATE_LIMIT_MS=30000

# Server Configuration
PORT=6000
CORS_ORIGIN=http://localhost:3000,http://localhost:48291,http://localhost:3001,https://quakenow.ovh,https://www.quakenow.ovh

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs

# Application Settings
EARTHQUAKE_FETCH_INTERVAL=30000
MIN_MAGNITUDE_ALERT=4.0
MAX_EARTHQUAKES_PER_FETCH=10
